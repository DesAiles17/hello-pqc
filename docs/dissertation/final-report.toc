\contentsline {subsection}{\numberline {5.1}Answering the Research Questions}{50}{subsection.5.1}%
\contentsline {paragraph}{RQ1: What is the performance overhead of post-quantum signature schemes in a complete end-to-end file-processing lifecycle?}{50}{section*.42}%
\contentsline {paragraph}{RQ2: How does hybrid signing affect latency and throughput?}{50}{section*.43}%
\contentsline {paragraph}{RQ3: What architectural harnesses are required for reproducible measurement?}{51}{section*.44}%
\contentsline {paragraph}{RQ4: What are the security implications of integrating PQC into a backend microservice architecture?}{51}{section*.45}%
\contentsline {subsection}{\numberline {5.2}Synthesis: What This Means for Practitioners}{52}{subsection.5.2}%
\contentsline {paragraph}{The performance case for PQC migration is stronger than expected.}{52}{section*.46}%
\contentsline {paragraph}{Storage amplification is the real PQC cost, not latency.}{52}{section*.47}%
\contentsline {paragraph}{The hybrid transition path is viable.}{52}{section*.48}%
