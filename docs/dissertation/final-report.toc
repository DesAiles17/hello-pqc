\contentsline {subsection}{\numberline {4.6}End-to-End Workflow Latency}{41}{subsection.4.6}%
\contentsline {paragraph}{Finding 1: FN-DSA and ML-DSA are faster than RSA-PSS end-to-end.}{41}{section*.27}%
\contentsline {paragraph}{Finding 2: The network and I/O floor dominates at all but the smallest files.}{42}{section*.28}%
\contentsline {paragraph}{Finding 3: SLH-DSA imposes prohibitive overhead for interactive use.}{43}{section*.29}%
