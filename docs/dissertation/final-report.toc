\contentsline {subsection}{\numberline {4.3}Signing Performance}{36}{subsection.4.3}%
\contentsline {paragraph}{Falcon (FN-DSA) outperforms ECDSA.}{37}{section*.23}%
\contentsline {paragraph}{ML-DSA is in the same order of magnitude as ECDSA.}{37}{section*.24}%
\contentsline {paragraph}{RSA-PSS is the slowest classical scheme by a wide margin.}{37}{section*.25}%
\contentsline {paragraph}{SLH-DSA is unusable for online workloads.}{38}{section*.26}%
\contentsline {subsection}{\numberline {4.4}Verification Performance}{38}{subsection.4.4}%
