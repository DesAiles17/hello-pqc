          <mxGeometry x="20" y="330" width="2360" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="gateway" value="API Gateway Core&#xa;- auth_middleware (API key + role)&#xa;- Rate limiters (sign/verify/hash/global/auth-fail)&#xa;- CORS + body limits&#xa;- /upload /process /verify /health&#xa;- request_id handling + orchestration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="500" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="upload_vol" value="Upload Working Storage&#xa;Volume: upload-data&#xa;/data/uploads/{key_fingerprint}/{uuid}-{sanitized_name}&#xa;- retention pruning&#xa;- per-key storage quota" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="620" y="380" width="420" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="tls_h" value="hasher-service-tls (Nginx)&#xa;HTTPS 3443 → HTTP 3001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1080" y="380" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="tls_m" value="manifest-builder-service-tls (Nginx)&#xa;HTTPS 3443 → HTTP 3002" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1080" y="470" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="tb2" value="Trust Boundary TB2&#xa;Gateway → Internal services&#xa;X-Service-Token + TLS CA validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1370" y="380" width="340" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="layer_crypto" value="Layer C: Cryptographic Services (Backend-only Crypto, Measured Stage Timings)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="580" width="2360" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="hasher" value="Hasher Service (Rust + Axum, 3001)&#xa;- validate_file_path + canonicalization&#xa;- no symlink policy + TOCTOU checks&#xa;- SHA-256 / Keccak-256 streaming hash&#xa;- multipart upload threshold (16MB)&#xa;- returns HashResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#3c78d8;" vertex="1" parent="1">
          <mxGeometry x="90" y="640" width="520" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="manifest" value="Manifest Builder Service (Rust + Axum, 3002)&#xa;- canonical CBOR manifest core&#xa;- domain separation: domain_sep || 0x00 || cbor&#xa;- Sign profiles: classical_only / pqc_only / hybrid&#xa;- RSA-PSS + Dilithium3 signing and verify&#xa;- age/revocation checks + profile satisfaction&#xa;- returns SignedManifest / VerifyResponse" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#3c78d8;" vertex="1" parent="1">
          <mxGeometry x="660" y="640" width="680" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="keys" value="Key Material (read-only mount)&#xa;./keys&#xa;- RSA private/public keys&#xa;- Dilithium secret/public keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1380" y="640" width="290" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="tls" value="TLS + CA Material (read-only)&#xa;./tls mounted as /app/tls&#xa;INTERNAL_CA_CERT_PATH used by reqwest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1380" y="745" width="290" height="95" as="geometry"/>
        </mxCell>

