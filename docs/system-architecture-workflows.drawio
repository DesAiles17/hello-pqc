          <mxGeometry x="20" y="90" width="2360" height="220" as="geometry"/>
        </mxCell>

        <mxCell id="webui" value="Web UI (React + TypeScript + Vite)&#xa;Port 5173 (dev)&#xa;- AuthContext + localStorage API key&#xa;- FileUploadZone / SignPage / VerifyPage&#xa;- Uses POST /upload, /process, /verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
