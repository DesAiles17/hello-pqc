        </mxCell>

        <mxCell id="tb1" value="Trust Boundary TB1&#xa;External Client → API Gateway&#xa;X-API-Key required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1720" y="140" width="280" height="140" as="geometry"/>
        </mxCell>

