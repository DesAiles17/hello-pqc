          <mxGeometry x="530" y="140" width="350" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="dataset" value="Benchmark Dataset&#xa;10KB / 100KB / 1MB / 10MB / 50MB&#xa;(Immutable during campaign)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="920" y="140" width="300" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="outputs" value="Benchmark Output Artifacts&#xa;output/benchmarks/&#xa;- benchmark-report-*.json&#xa;- benchmark-runs-*.csv&#xa;- benchmark-summary-*.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
