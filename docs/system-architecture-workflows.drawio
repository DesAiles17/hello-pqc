        <mxCell id="title" value="Post-Quantum Cryptography Signing System (Current Technical State)&#xa;Formal Low-Level Architecture with Explicit Workflow Labels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="2360" height="50" as="geometry"/>
