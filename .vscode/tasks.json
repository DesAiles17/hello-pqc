{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run example: oqs_signs",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run",
                "--example",
                "oqs_signs"
            ],
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}